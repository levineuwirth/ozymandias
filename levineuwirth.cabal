cabal-version:      3.0
name:               levineuwirth
version:            0.1.0.0
synopsis:           Build system for levineuwirth.org
license:            MIT
license-file:       LICENSE
author:             Levi Neuwirth
maintainer:         levi@levineuwirth.org
build-type:         Simple

executable site
    main-is:          Main.hs
    hs-source-dirs:   build
    other-modules:
        Config
        Site
        SiteThreads
        Archive
        ArchiveIndex
        Authors
        Catalog
        Commonplace
        Now
        Vita
        Backlinks
        Dingbat
        Drafts
        EngineFiles
        PageScan
        RouteCheck
        PandocOptions
        Sections
        SimilarLinks
        FooterData
        Compilers
        Golden
        Contract
        Contexts
        Marks
        MarkdownSections
        Patterns
        Photography
        Stats
        Stability
        SvgColor
        Tags
        Pagination
        Citations
        BibExtras
        Filters
        Filters.Typography
        Filters.FigureRefs
        Filters.Sidenotes
        Filters.Dropcaps
        Filters.Smallcaps
        Filters.Archive
        Filters.CodeRefs
        Filters.Wikilinks
        Filters.Transclusion
        Filters.EmbedPdf
        Filters.Links
        Filters.SourceRefs
        Filters.Math
        Filters.Headings
        Filters.Code
        Filters.Images
        Filters.Score
        Filters.Aftermatter
        Filters.Viz
        Utils
    build-depends:
        base                 >= 4.18  && < 5,
        hakyll               >= 4.16  && < 4.17,
        pandoc               >= 3.1   && < 3.7,
        pandoc-types         >= 1.23  && < 1.24,
        text                 >= 2.0   && < 2.2,
        containers           >= 0.6   && < 0.8,
        filepath             >= 1.4   && < 1.6,
        directory            >= 1.3   && < 1.4,
        time                 >= 1.12  && < 1.15,
        aeson                >= 2.1   && < 2.3,
        scientific           >= 0.3   && < 0.4,
        vector               >= 0.12  && < 0.14,
        yaml                 >= 0.11  && < 0.12,
        bytestring           >= 0.11  && < 0.13,
        process              >= 1.6   && < 1.7,
        data-default         >= 0.7   && < 0.8,
        mtl                  >= 2.3   && < 2.4,
        blaze-html           >= 0.9   && < 0.10,
        blaze-markup         >= 0.8   && < 0.9
    default-language:   GHC2021
    ghc-options:
        -threaded
        -Wall
